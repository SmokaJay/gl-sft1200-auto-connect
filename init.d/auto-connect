#!/bin/sh /etc/rc.common
# /etc/init.d/auto-connect
# OpenWrt init script for the auto-connect WiFi daemon.

START=99
STOP=10
USE_PROCD=1

DAEMON="/usr/sbin/auto-connect.sh"
PIDFILE="/var/run/auto-connect.pid"

start_service() {
    procd_open_instance
    procd_set_param command "$DAEMON"
    procd_set_param respawn 3600 5 0   # respawn: threshold=3600s, timeout=5s, retry=infinite
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile "$PIDFILE"
    procd_close_instance
}

stop_service() {
    rm -f "$PIDFILE"
}

reload_service() {
    stop
    start
}
