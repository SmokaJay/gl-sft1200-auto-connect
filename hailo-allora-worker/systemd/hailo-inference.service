[Unit]
Description=Hailo Inference Service for Allora
After=network.target
Requires=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/hailo-allora-worker/inference
ExecStart=/usr/bin/python3 -m uvicorn inference_service:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hailo-inference
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
